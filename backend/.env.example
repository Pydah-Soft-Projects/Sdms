# CRT workspace SSO (JWT signed with SDMS_SSO_SECRET — must match CRT server's SDMS_SSO_SECRET)
# Algorithm: HS256 | Payload: { sub: <admission_number> } | Expiry: 5 min
# Redirect: https://crt.pydah.edu.in/sso-login?token=<jwt>
SDMS_SSO_SECRET="pydah@SDMS_CRT_sso_2024#secure"
CRT_APP_URL=https://crt.pydah.edu.in
# CRT_SSO_TOKEN_EXPIRES_IN is no longer used; expiry is hardcoded to 5 min per CRT spec.

# Portal SSO: CRM backend (verify-token). Default localhost:8000.
CRM_BACKEND_URL=http://localhost:8000

# Default Admin Credentials (for initial setup)
