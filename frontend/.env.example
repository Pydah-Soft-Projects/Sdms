# Frontend Environment Variables - LOCAL DEVELOPMENT (Connected to Local Backend)
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME="Pydah Student Database Management System"
VITE_APP_VERSION="1.0.0"

# Portal SSO: CRM backend (verify-token) and frontend (return link). Defaults below.
VITE_CRM_BACKEND_URL=http://localhost:8000
VITE_CRM_FRONTEND_URL=http://localhost:5174

# Hosted maintenance portal (ticket-management SSO)
VITE_TICKET_APP_URL=https://maintenance.pydah.edu.in
# Maintenance API used by student complaints and ticket history. Local development
# proxies this path to the hosted maintenance API; set http://localhost:5001/api
# here only when running the maintenance backend locally.
VITE_MAINTENANCE_API_URL=/maintenance-api/api

# CRT training app (student Workspace → CRT Training Portal SSO)
VITE_CRT_APP_URL=https://crt.pydahsoft.in

# For production deployment, create a .env.production file with:
# VITE_API_URL=https://your-backend-domain.com/api
# VITE_CRM_BACKEND_URL=https://crm-backend.example.com
# VITE_CRM_FRONTEND_URL=https://crm-frontend.example.com
# VITE_TICKET_APP_URL=https://maintenance.pydah.edu.in
# VITE_MAINTENANCE_API_URL=https://maintenance.pydah.edu.in/api
# Set only to the hosted HTTPS payment SDK URL; never use localhost in production.
# VITE_PPG_SDK_URL=https://payments.example.com/sdk/ppg.js

# NOTE: This configuration connects local frontend development to the local SDMS
# backend and proxies maintenance requests to the hosted maintenance service.
# For hosted backend, change VITE_API_URL to https://pydahsdbms.onrender.com/api
